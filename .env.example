# ========================================
# VITE CONFIGURATION (Frontend)
# ========================================

# API URL dla frontendu (MUSI zaczynać się od VITE_)
VITE_API_URL=http://localhost:1337/api
VITE_STRAPI_URL=http://localhost:1337

# Inne zmienne frontendowe
VITE_APP_NAME="MS Box Inventory"
VITE_APP_VERSION=1.0.0

# ========================================
# STRAPI CONFIGURATION (Backend)
# ========================================

# Server Configuration
HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# Frontend URL (dla Strapi CORS)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Strapi Secrets (Użyj `openssl rand -base64 32` do wygenerowania)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Database Configuration
DATABASE_CLIENT=mysql
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false

# AWS S3 Configuration (for file uploads)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# Optional Strapi Settings
STRAPI_TELEMETRY_DISABLED=true

# Optional Database Settings
DATABASE_CONNECTION_TIMEOUT=60000
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10 